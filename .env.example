# Solana wallet private key — auto-detected format:
#   base58 (e.g. Phantom/Solflare export, 51-52 chars) OR
#   base64 OR
#   JSON keypair array (contents of id.json, e.g. [12,34,...])
SOLANA_WALLET_KEY=
# Path to keypair file (e.g. /secure/path/id.json) — used if SOLANA_WALLET_KEY is empty
WALLET_PATH=

# Solana RPC endpoint (HTTPS)
RPC_URL=https://api.devnet.solana.com

# Telegram bot (REQUIRED since v0.4 — command & control runs via Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
